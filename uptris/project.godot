; Engine configuration file.
; UPTRIS Milestone 0 — Project Genesis
; https://godotengine.org/project-manager

config_version=5

[application]

config/name="UPTRIS"
config/description="ONE BRICK. EVERY GAME. A continuously transforming arcade adventure built from living electronic bricks."
config/version="0.0.0-m0"
config/tags=PackedStringArray("arcade", "brick", "godot4")
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UptrisLog="*res://src/Core/uptris_log.gd"
PlatformService="*res://src/Core/platform_service.gd"
AppConfig="*res://src/Core/app_config.gd"
DebugService="*res://src/Debug/debug_service.gd"
InputService="*res://src/Input/input_service.gd"
EventBus="*res://src/Core/event_bus.gd"
GameDirector="*res://src/GameDirector/game_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

