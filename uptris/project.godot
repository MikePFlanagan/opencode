[internationalization]

locale/fallback="en"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="bricks"
2d_physics/layer_3="assemblies"
2d_physics/layer_4="player"
2d_physics/layer_5="enemies"
2d_physics/layer_6="projectiles"
2d_physics/layer_7="triggers"
2d_physics/layer_8="ui"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
